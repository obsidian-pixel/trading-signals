# Binance API Credentials (OPTIONAL - not required for public market data)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_secret_key_here

# Trading Configuration
SYMBOL=BTCUSDT
TIMEFRAME=1m
LOOKBACK_PERIOD=60

# Model Configuration
PREDICTION_CONFIDENCE_THRESHOLD=0.70
ENSEMBLE_WEIGHTS_LSTM=0.30
ENSEMBLE_WEIGHTS_CNN=0.25
ENSEMBLE_WEIGHTS_RF=0.20
ENSEMBLE_WEIGHTS_XGB=0.25

# Risk Management
MAX_POSITION_SIZE=0.1  # 10% of capital per trade
STOP_LOSS_PCT=0.01     # 1% stop loss
PROFIT_TARGET_PCT=0.015  # 1.5% profit target
TRAILING_STOP_PCT=0.008  # 0.8% trailing stop

# Strategy Parameters
MAX_TRADES_PER_HOUR=5
MIN_TRADE_INTERVAL_SECONDS=60

# Data Storage
DATA_DIR=./data
MODELS_DIR=./models
LOGS_DIR=./logs

# Logging
LOG_LEVEL=INFO
